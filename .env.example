# --- Kopiere diese Datei nach ".env" und trag deinen Key ein ----------------

# NVIDIA NIM (Dev-Key gratis auf https://build.nvidia.com -> "Get API Key")
JARVIS_API_KEY=nvapi-DEIN_KEY_HIER
JARVIS_BASE_URL=https://integrate.api.nvidia.com/v1
# Wunschreihenfolge, bestes zuerst. Beim Start werden alle gleichzeitig
# angepingt; genommen wird das erste, das antwortet.
JARVIS_MODELS=moonshotai/kimi-k3,openai/gpt-oss-20b,meta/llama-3.2-11b-vision-instruct
# reihenfolge = bestes verfuegbares gewinnt | schnellste = kuerzeste Zeit gewinnt
JARVIS_MODELL_WAHL=reihenfolge

JARVIS_RETRIES=3

# Alternativen (nur falls du mal wechseln willst):
#   Moonshot direkt:  https://api.moonshot.ai/v1        + Modell: kimi-k3
#   OpenRouter:       https://openrouter.ai/api/v1      + Modell: moonshotai/kimi-k3

# --- Antwortverhalten ------------------------------------------------------
# low = schnell (gut fuer Sprache), max = maximale Denktiefe (langsam)
JARVIS_REASONING_EFFORT=low
JARVIS_MAX_TOKENS=1024
JARVIS_TEMPERATURE=0.6

# --- Persoenlichkeit / Sprache ---------------------------------------------
JARVIS_USER_NAME=Sir
JARVIS_TTS=1
JARVIS_TTS_BACKEND=auto
# Weitere Stimmen:  .venv\Scripts\python.exe -m piper.download_voices <name> --data-dir voices
#   de_DE-thorsten-medium (maennlich, ruhig)  de_DE-thorsten-high (besser, langsamer)
#   de_DE-karlsson-low (maennlich, schnell)   de_DE-eva_k-x_low (weiblich)
JARVIS_PIPER_VOICE=de_DE-thorsten-medium
JARVIS_TTS_LENGTH_SCALE=1.0
JARVIS_TTS_VOLUME=1.0
# nur fuer den SAPI-Notnagel:
JARVIS_TTS_VOICE=german
JARVIS_TTS_RATE=185
JARVIS_STT_MODEL=small
JARVIS_STT_LANGUAGE=de

# Eingabezeile ohne Live-Vorschlaege (falls die Konsole Zeichensalat zeigt)
# JARVIS_SIMPLE_INPUT=1

# Beim Start alle Modelle anpingen (1/0)
JARVIS_STARTUP_CHECK=1
# Nach so vielen Sekunden ohne Antwort aufgeben. Escape bricht sofort ab.
JARVIS_TIMEOUT=120

# Englische Stellen mit englischer Stimme sprechen (1/0)
JARVIS_SPRACHWECHSEL=1
JARVIS_PIPER_VOICE_EN=en_GB-alan-medium

# --- Bildschirm ansehen ----------------------------------------------------
# ACHTUNG: dabei geht ein Foto deines Bildschirms an NVIDIA. 0 schaltet es ab.
JARVIS_BILDSCHIRM=1
# Muss ein Modell mit 'vision' im Namen sein - ein Textmodell antwortet
# sonst klaglos mit leerem Text.
JARVIS_BILD_MODELL=meta/llama-3.2-11b-vision-instruct
# 1.0 = native Aufloesung des Monitors, 0.5 = halbe Kantenlaenge
JARVIS_BILD_SKALIERUNG=1.0

# --- Code schreiben --------------------------------------------------------
# Eigenes Limit: das Gespraech bleibt kurz, weil es vorgelesen wird.
# Ein hohes Limit kostet nichts - abgerechnet wird, was erzeugt wird.
JARVIS_CODE_TOKENS=6000
# leer = das gerade laufende Modell
JARVIS_CODE_MODELL=

# --- Agenten (Mk 1, Mk 2 ...) ----------------------------------------------
# leer = ein Drittel der logischen Prozessoren, hoechstens 4
JARVIS_MAX_AGENTEN=
# Reissleinen gegen Agenten, die sich festfressen
JARVIS_AGENT_ZEITLIMIT=300
JARVIS_AGENT_MAX_VERLAUF=80000
JARVIS_AGENT_MIN_FREI_MB=400
JARVIS_AGENT_MAX_PROZESS_MB=1200

# --- Briefkasten (freiwillig) ---------------------------------------------
# Jarvis sieht damit NUR Absender, Betreff und Uhrzeit neuer Mails - nie den
# Inhalt. Bei Gmail und Outlook braucht es ein App-Passwort, nicht das
# normale Kennwort. Trag es hier selbst ein und nenne es niemandem im Chat.
#   Gmail   : imap.gmail.com
#   Outlook : outlook.office365.com
#   GMX     : imap.gmx.net
#   Web.de  : imap.web.de
JARVIS_MAIL_SERVER=
JARVIS_MAIL_BENUTZER=
JARVIS_MAIL_PASSWORT=
JARVIS_MAIL_ORDNER=INBOX
